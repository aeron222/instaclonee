{
  "functions": {
    "api/request.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/request?path=/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://instaclonee-5.onrender.com/uploads/:path*"
    }
  ]
}
